# solpay-shop configuration. `make env` copies this file to .env and generates the
# secrets. By hand: cp .env.example .env, then replace every placeholder.
# Never commit .env. This file holds placeholders only, no keys and no secrets.

# HTTP listen address. Loopback keeps the admin pages off the network; use :8080 to listen on
# all interfaces.
APP_ADDR=127.0.0.1:8080
# Password of the local Postgres user. `make env` generates it.
# Letters and digits only: DATABASE_URL embeds it.
POSTGRES_PASSWORD=
# Host ports that compose publishes on 127.0.0.1. Change them if a local Postgres or another
# service already uses 5432 or 8080.
DB_PORT=5432
APP_PORT=8080
# Postgres connection URL. `make run` starts the compose database on localhost:$DB_PORT.
DATABASE_URL=postgres://solpay:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/solpay?sslmode=disable
# Solana JSON-RPC endpoint.
# The public endpoint allows ~10 calls per method per 10 s. A free keyed devnet endpoint also
# works; its URL contains the key, so it is a secret and stays in .env.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Base58 address (public key) of a devnet-only wallet you control. It receives the
# payments; the shop never needs its secret key. `make env` prints how to get one.
# A merchant account that was never funded needs a first payment at or above the
# rent-exempt minimum; the demo prices already are.
MERCHANT_ADDRESS=your-devnet-wallet-address
# How long an order waits for payment (Go duration, 1m..24h).
ORDER_TTL=15m
# Payment watcher poll interval (Go duration, 1s..1m).
POLL_INTERVAL=5s
# HTTP basic auth for /admin and /api/v1/admin. The password needs at least
# 12 characters; `make env` generates one.
ADMIN_USER=admin
ADMIN_PASS=change-me
# Optional: also write JSON logs to this file (stdout is always on). Empty = stdout only.
LOG_FILE=./data/app.log
# HMAC key for download links, at least 32 bytes. `make env` generates one
# (openssl rand -hex 32).
DOWNLOAD_SECRET=change-me
# Directory holding the product files that can be sold.
FILES_DIR=./testdata/files
